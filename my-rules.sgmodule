#!name=我的个人规则
#!desc=配合 lazy_group.conf 使用

[Rule]

# 加密货币：使用 V台湾 03
RULE-SET,https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/meta/geo/geosite/classical/binance.list,V台湾 03
RULE-SET,https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/meta/geo/geosite/classical/bybit.list,V台湾 03

# 域名后缀匹配
DOMAIN-SUFFIX,potoh.com,PROXY
DOMAIN-SUFFIX,lyxazy.cn,PROXY
DOMAIN-SUFFIX,ultramobile.com,vless-S5-ATT
DOMAIN-SUFFIX,ultra.me,vless-S5-ATT

# 关键词匹配，拒绝
DOMAIN-KEYWORD,adobe,REJECT

# 关键词匹配，连接
DOMAIN-KEYWORD,ultramobile,vless-S5-ATT

# 直连示例：把 example.com 换成需要直连的网站
DOMAIN-SUFFIX,example.com,DIRECT

# 精确拦截示例：把域名换成需要拦截的域名
DOMAIN,ads.example.net,REJECT
